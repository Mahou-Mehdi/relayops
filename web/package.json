{
  "name": "relayops-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json .prettierrc.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" index.html vite.config.ts tsconfig.json package.json .prettierrc.json"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  }
}
